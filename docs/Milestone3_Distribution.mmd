flowchart LR
    client["Client: REST API or Thymeleaf website"] --> scheduler["Appointment Scheduler: shared AppointmentService"]
    scheduler --> tx["Booking / cancellation transaction: row locks + validation"]
    tx --> db[("PostgreSQL: appointments + availability")]
    tx --> event["Immutable notification event: delivered only AFTER COMMIT"]
    event --> listener["Shared listener: NOT_SUPPORTED suspends transaction resources"]
    listener --> gateway["Notification Gateway: configurable HTTP URL"]
    gateway -->|"HTTP POST /notifications: stable ID + complete DTO"| receiver["Mock Notification Service: second REST controller"]
    receiver --> inbox[("PostgreSQL: unique notification receipt + payload hash")]
    gateway --> resilience["500 ms connect / 1000 ms response timeout; 3 attempts; 100 ms delay"]
    resilience --> fallback["WARN fallback: booking / cancellation remains committed"]
    receiver -->|"200 RECEIVED or DUPLICATE; 409 changed payload"| gateway
